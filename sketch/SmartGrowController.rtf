#include "Config.h"\
#include "GrowData.h"\
\
#include "HAL.h"\
#include "SensorManager.h"\
#include "TaskManager.h"\
\
//=====================================================================\
// Global Objects\
//=====================================================================\
\
HAL hal;\
GrowData grow;\
\
SensorManager sensors(hal);\
\
TaskManager scheduler;\
\
//=====================================================================\
// Scheduled Tasks\
//=====================================================================\
\
void taskReadSensors()\
\{\
    sensors.update(grow);\
\}\
\
//=====================================================================\
// Setup\
//=====================================================================\
\
void setup()\
\{\
    Serial.begin(SERIAL_BAUD);\
\
    DEBUG_PRINTLN();\
    DEBUG_PRINTLN("====================================");\
    DEBUG_PRINTLN(" Flora Core");\
    DEBUG_PRINT(" Version: ");\
    DEBUG_PRINTLN(FLORA_VERSION);\
    DEBUG_PRINTLN("====================================");\
\
    hal.begin();\
\
    sensors.begin();\
\
    scheduler.begin();\
\
    scheduler.addTask(taskReadSensors, SENSOR_INTERVAL);\
\
    DEBUG_PRINTLN("Initialization Complete");\
\}\
\
//=====================================================================\
// Main Loop\
//=====================================================================\
\
void loop()\
\{\
    scheduler.update();\
\}}